# Django
# Generate a new key with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-value
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Database (local PostgreSQL 18)
# Create the "edumind" role and database first (see README.md).
# Replace DB_PASSWORD with the password chosen for that role.
DB_NAME=edumind
DB_USER=edumind
DB_PASSWORD=edumind_dev_password
DB_HOST=localhost
DB_PORT=5432

# Uploads
MAX_UPLOAD_SIZE_MB=50
MAX_VIDEO_UPLOAD_SIZE_MB=500
AVATAR_MAX_SIZE_MB=5
THUMBNAIL_MAX_SIZE_MB=2
THUMBNAIL_MAX_WIDTH=1920
THUMBNAIL_MAX_HEIGHT=1080

# Cookies (set to True behind HTTPS in production)
COOKIE_SECURE=False

# Login throttling
LOGIN_THROTTLE_ATTEMPTS=5
LOGIN_THROTTLE_WINDOW_SECONDS=60

# Course video transcripts (Cohere)
# Create a key at https://dashboard.cohere.com/api-keys
COHERE_API_KEY=
COHERE_TRANSCRIBE_MODEL=cohere-transcribe-03-2026
COHERE_CHAT_MODEL=command-a-03-2025
COHERE_TRANSCRIPT_LANGUAGE=en
TRANSCRIPT_CHUNK_SECONDS=120
TRANSCRIPT_FFMPEG_TIMEOUT_SECONDS=900
TRANSCRIPT_STALE_MINUTES=30

# Course recommendations (local scikit-learn, no external API)
# RECOMMENDATION_MODEL_PATH defaults to Backend/ml_models/recommendations.pkl
RECOMMENDATION_MODEL_PATH=
RECOMMENDATION_RETRAIN_DAYS=7
RECOMMENDATION_CACHE_TIMEOUT=604800
RECOMMENDATION_AUTO_RETRAIN=True
