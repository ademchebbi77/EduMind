# Django
# Generate a new key with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-value
DEBUG=True
# host.docker.internal lets the monitoring containers scrape the API.
ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal
CSRF_TRUSTED_ORIGINS=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Secret code required to sign up with the administrator role (empty = disabled).
# Use a long random value, e.g. python -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_REGISTRATION_CODE=

# Database (local PostgreSQL 18)
# Create the "edumind" role and database first (see README.md).
# Replace DB_PASSWORD with the password chosen for that role.
DB_NAME=edumind
DB_USER=edumind
DB_PASSWORD=edumind_dev_password
DB_HOST=localhost
DB_PORT=5432

# Uploads
MAX_UPLOAD_SIZE_MB=50
MAX_VIDEO_UPLOAD_SIZE_MB=500
AVATAR_MAX_SIZE_MB=5
THUMBNAIL_MAX_SIZE_MB=2
THUMBNAIL_MAX_WIDTH=1920
THUMBNAIL_MAX_HEIGHT=1080

# Course form auto-fill (local NLP)
CONTENT_ANALYZER_MAX_WORDS=5000
CONTENT_ANALYZER_PDF_PAGES=5
CONTENT_ANALYZER_MEDIA_SECONDS=180
CONTENT_ANALYZER_WHISPER_MODEL=tiny
# Leave empty to let Whisper detect the spoken language.
CONTENT_ANALYZER_LANGUAGE=
CONTENT_ANALYZER_FFMPEG_TIMEOUT_SECONDS=300

# Cookies (set to True behind HTTPS in production)
COOKIE_SECURE=False

# Login throttling
LOGIN_THROTTLE_ATTEMPTS=5
LOGIN_THROTTLE_WINDOW_SECONDS=60

# Monitoring (Prometheus + Grafana, see docker-compose.monitoring.yml)
# GET /metrics/ requires this bearer token; leave it empty to disable the endpoint.
# The same value is handed to Prometheus by Docker Compose.
METRICS_TOKEN=edumind-dev-metrics-token
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=edumind

# Course video transcripts (Cohere)
# Create a key at https://dashboard.cohere.com/api-keys
COHERE_API_KEY=
COHERE_TRANSCRIBE_MODEL=cohere-transcribe-03-2026
COHERE_CHAT_MODEL=command-a-03-2025
COHERE_TRANSCRIPT_LANGUAGE=en
TRANSCRIPT_CHUNK_SECONDS=120
TRANSCRIPT_FFMPEG_TIMEOUT_SECONDS=900
TRANSCRIPT_STALE_MINUTES=30

# Course recommendations (local scikit-learn, no external API)
# RECOMMENDATION_MODEL_PATH defaults to Backend/ml_models/recommendations.pkl
RECOMMENDATION_MODEL_PATH=
RECOMMENDATION_RETRAIN_DAYS=7
RECOMMENDATION_CACHE_TIMEOUT=604800
RECOMMENDATION_AUTO_RETRAIN=True

# Background jobs: Celery + Redis (local quiz generator)
# Start Redis with: docker run -d --name edumind-redis -p 6379:6379 redis:7-alpine
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# True runs jobs inside the web process (no Redis/worker needed). Local dev only.
CELERY_TASK_ALWAYS_EAGER=False
# runserver also starts Redis (Docker) and the Celery worker. Set False to run them yourself.
AUTO_START_BACKGROUND_SERVICES=True
QUIZ_GENERATION_MAX_ACTIVE_JOBS=3
QUIZ_GENERATION_STALE_MINUTES=10

# Voice questions (OpenAI Whisper speech-to-text + Google Gemini answers)
# Keys are only read by the backend; never put them in the frontend.
# Speech-to-text: "local" = free open-source Whisper on the server (default);
# "openai" = paid Whisper API (needs OPENAI_API_KEY with credit).
VOICE_QA_TRANSCRIPTION_PROVIDER=local
VOICE_QA_WHISPER_MODEL=base
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
VOICE_QA_MAX_AUDIO_MB=25
VOICE_QA_MAX_RECORDING_SECONDS=180

# Summaries & AI resources (Gemini summaries, key concepts, course chat, illustrations)
# Uses GEMINI_API_KEY above. Models tried in order when one is busy:
SUMMARIES_GEMINI_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite,gemini-3.5-flash-lite
# Illustrations: "pollinations" (free, no key) or "gemini" (needs a billed Gemini key)
SUMMARIES_IMAGE_PROVIDER=pollinations
SUMMARIES_AI_REQUESTS_PER_HOUR=60
