[run]
# Every Django app; file paths stay relative to Backend/ so CI tools (SonarQube)
# can match them.
source = .
relative_files = True
branch = True
omit =
    */migrations/*
    */tests/*
    manage.py

[report]
show_missing = True
skip_covered = False
fail_under = 85
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
    raise NotImplementedError
    if TYPE_CHECKING:
